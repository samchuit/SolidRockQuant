# SolidRockQuant 配置示例：复制为 .env 并按需修改
# 所有变量前缀 SOLIDROCK_，也可直接用环境变量

# 数据目录（默认 ./.solidrock）
# SOLIDROCK_DATA_DIR=D:/quant_data

# 默认数据源：akshare（免费无需 token）或 tushare
# SOLIDROCK_DEFAULT_SOURCE=akshare

# Tushare Pro token（https://tushare.pro 注册获取；部分接口需 2000 积分）
# SOLIDROCK_TUSHARE_TOKEN=your-token-here

# 交易费用默认值（回测用，可在策略中覆盖；费率随政策变动）
# SOLIDROCK_COMMISSION_RATE=0.00025
# SOLIDROCK_STAMP_DUTY_RATE=0.0005

# ---- 实盘（QMT / cfquant 桥接）----
# QMT 资金账号（cfquant 桥接需已在线）
# SOLIDROCK_LIVE_ACCOUNT_ID=你的资金账号
# 账户类型：STOCK（普通）/ CREDIT（信用）/ FUTURE 等
# SOLIDROCK_LIVE_ACCOUNT_TYPE=STOCK
# 只读模式（默认 true：只允许查询；任何下单/撤单都会被拒绝）
# 真实下单必须显式设为 false，且 MCP 工具还需传 confirm=true
# SOLIDROCK_LIVE_READ_ONLY=false

# ---- 实盘下单守卫（Guard：在 broker 内强制执行，无法通过传参跳过）----
# 单笔最大名义金额（元）；0 或负数 = 关闭该检查
# SOLIDROCK_LIVE_MAX_ORDER_NOTIONAL=500000
# 允许交易的标的（逗号分隔）；留空 = 不限制。强烈建议配置，防止代码笔误打错标的
# SOLIDROCK_LIVE_SYMBOL_WHITELIST=510300.SH,511010.SH
# 非交易日/非交易时段是否拒绝下单（建议保持 true）
# SOLIDROCK_LIVE_ENFORCE_TRADING_HOURS=true
# 相同订单（标的方向数量价格）在此秒数内视为重复委托并拒绝；0 = 关闭
# SOLIDROCK_LIVE_DUPLICATE_WINDOW_SECONDS=60

# ---- 通知（钉钉/企微/通用 webhook）----
# SOLIDROCK_NOTIFY_WEBHOOK=https://...
# SOLIDROCK_NOTIFY_TYPE=generic

